#!/bin/bash
# ==========================================
# 💎 PREMIUM BACKUP SCRIPT V4.4 (LINK FIX)
# ==========================================

# --- CONFIGURATION & COLORS ---
NC='\033[0m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
B_CYAN='\033[1;36m'
B_WHITE='\033[1;37m'

# --- PREMIUM ASSETS (PROGRESS BAR) ---
fun_bar() {
    CMD="$1"
    TEXT="$2"
    eval "$CMD" >/dev/null 2>&1 &
    PID=$!
    tput civis
    echo -ne "  ${CYAN}${TEXT} ${NC}"
    while kill -0 $PID 2>/dev/null; do
        for i in {1..4}; do echo -ne "\033[0;32m▓"; sleep 0.1; done
    done
    wait $PID
    if [ $? -eq 0 ]; then
        echo -e "  ${CYAN}⚡ ${TEXT} : ${GREEN}SUKSES ✅${NC}"
    else
        echo -e "  ${CYAN}⚡ ${TEXT} : ${RED}GAGAL ❌${NC}"
    fi
    tput cnorm
}

# --- HEADER ---
clear
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${YELLOW}           🛡️  GENOM CLOUD BACKUP PRO  🛡️        ${NC}"
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${B_WHITE}  Tanggal : $(date +'%Y-%m-%d') ${NC}"
echo -e "${B_WHITE}  Waktu   : $(date +'%H:%M:%S') ${NC}"
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# --- PERSIAPAN ---
IP=$(curl -sS ipv4.icanhazip.com)
domain=$(cat /etc/xray/domain 2>/dev/null || echo "Domain Not Set")
timestamp=$(date +"%Y%m%d_%H%M%S")
BACKUP_DIR="/root/backup_${timestamp}"
BACKUP_FILE_NAME="backup_${IP}_${timestamp}.zip"
BACKUP_FILE_PATH="/root/${BACKUP_FILE_NAME}"

# --- 1. MENGUMPULKAN DATA ---
echo -e "${B_WHITE}[1/4] Mengumpulkan File System...${NC}"

# File Penting
files_to_backup=("/etc/passwd" "/etc/group" "/etc/shadow" "/etc/gshadow" "/etc/crontab")

# Folder Penting
dirs_to_backup=(
    "/etc/xray" 
    "/var/lib/kyt" 
    "/var/www/html" 
    "/usr/bin/kyt"
    "/etc/zivpn"
    "/etc/v2ray"
    "/etc/trojan"
    "/etc/shadowsocks-libev"
)

cmd_copy() {
    mkdir -p "$BACKUP_DIR"
    # Copy Files
    for file in "${files_to_backup[@]}"; do 
        if [ -f "$file" ]; then cp -p "$file" "$BACKUP_DIR/"; fi
    done
    
    # Copy Dirs
    for dir in "${dirs_to_backup[@]}"; do 
        if [ -d "$dir" ]; then cp -r "$dir" "$BACKUP_DIR/"; fi
    done
    
    return 0 
}
fun_bar "cmd_copy" "Copying Data System  "

# --- 2. KOMPRESI ZIP ---
echo -e "${B_WHITE}[2/4] Membuat Arsip ZIP...${NC}"
cmd_zip() { cd "$BACKUP_DIR" || return 1; zip -r "$BACKUP_FILE_PATH" . ; }
fun_bar "cmd_zip" "Compressing to ZIP   "

if [ ! -f "$BACKUP_FILE_PATH" ]; then
    echo -e "\n${RED}ERROR FATAL: Gagal membuat file backup!${NC}"; rm -rf "$BACKUP_DIR"; exit 1
fi

# --- 3. UPLOAD GOOGLE DRIVE ---
echo -e "${B_WHITE}[3/4] Upload ke Cloud Storage...${NC}"
LINK="Tidak tersedia"

if command -v rclone &> /dev/null; then
    cmd_upload() { rclone copy "$BACKUP_FILE_PATH" dr:backup/; }
    fun_bar "cmd_upload" "Uploading to GDrive  "
    
    # Ambil Link
    RAW_LINK=$(rclone link dr:backup/"$BACKUP_FILE_NAME" 2>/dev/null)
    if [[ "$RAW_LINK" =~ "id=" ]]; then 
        LINK="$RAW_LINK"
    fi
else
    echo -e "  ${YELLOW}⚠️  Rclone tidak terinstall. Skip upload.${NC}"
fi

# --- 4. KIRIM NOTIFIKASI TELEGRAM ---
echo -e "${B_WHITE}[4/4] Mengirim ke Telegram...${NC}"

# === AUTO DETECT TOKEN ===
if [[ -f "/etc/per/id" && -f "/etc/per/token" ]]; then
    CHATID=$(cat /etc/per/id)
    KEY=$(cat /etc/per/token)
elif [[ -f "/etc/bot/.bot.db" ]]; then
    CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 3)
    KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 2)
elif [[ -f "/usr/bin/idchat" && -f "/usr/bin/token" ]]; then
    CHATID=$(cat /usr/bin/idchat)
    KEY=$(cat /usr/bin/token)
fi

if [[ -n "$CHATID" && -n "$KEY" ]]; then
    URL_MSG="https://api.telegram.org/bot$KEY/sendMessage"
    URL_DOC="https://api.telegram.org/bot$KEY/sendDocument"
    
    # Pesan Teks (FIXED: Menggunakan karakter aman)
    MSG="
<b>☁️ CLOUD BACKUP NOTIFICATION</b>
━━━━━━━━━━━━━━━━━━━━━
<b>🆔 IP VPS :</b> <code>$IP</code>
<b>🌐 DOMAIN :</b> <code>$domain</code>
<b>📅 TANGGAL:</b> <code>$(date '+%Y-%m-%d')</code>
<b>⏰ WAKTU  :</b> <code>$(date '+%H:%M:%S')</code>
━━━━━━━━━━━━━━━━━━━━━
<b>📂 BACKUP CONTENTS</b>
✅ SSH and System Config
✅ Xray and Trojan Config
✅ <b>ZiVPN User Database</b>
✅ Web and Panel Data
━━━━━━━━━━━━━━━━━━━━━
<b>💾 FILE INFO</b>
<b>Nama File :</b> <code>$BACKUP_FILE_NAME</code>
<b>Ukuran    :</b> <code>$(du -h "$BACKUP_FILE_PATH" | awk '{print $1}')</code>
<b>Link GDrive :</b> <a href='$LINK'>Klik Disini Untuk Download</a>
━━━━━━━━━━━━━━━━━━━━━
<i>File ZIP akan dikirim setelah pesan ini 👇</i>
"
    # 1. Kirim Pesan Teks (FIX: Gunakan --data-urlencode untuk menangani link panjang)
    curl -s --data-urlencode "text=$MSG" -d "chat_id=$CHATID" -d "parse_mode=html" -d "disable_web_page_preview=1" "$URL_MSG" >/dev/null
    
    # 2. Kirim File ZIP
    cmd_send_file() {
        curl -s -F "chat_id=$CHATID" \
             -F "document=@$BACKUP_FILE_PATH" \
             -F "caption=📦 Backup File: $timestamp" \
             "$URL_DOC"
    }
    fun_bar "cmd_send_file" "Sending ZIP to Bot   "
else
    echo -e "  ${YELLOW}⚠️  Konfigurasi Bot Telegram tidak ditemukan.${NC}"
fi

# --- BERSIH-BERSIH ---
rm -rf "$BACKUP_DIR"
# rm -f "$BACKUP_FILE_PATH" # Uncomment jika ingin menghapus file lokal setelah kirim

echo ""
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}           ✅ BACKUP BERHASIL SELESAI            ${NC}"
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e " ${B_WHITE}📂 Lokasi File :${NC} ${YELLOW}$BACKUP_FILE_PATH${NC}"
echo -e " ${B_WHITE}🔗 Link GDrive :${NC} ${CYAN}$LINK${NC}"
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
