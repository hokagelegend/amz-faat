#!/bin/bash
# My Telegram : https://t.me/hokagevpnpremium
# ==========================================
# FINAL ROBUST VERSION - COMPATIBLE WITH OLD BACKUP SCRIPT
# ==========================================
# Color
RED='\033[0;31m'
NC='\033[0m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
LIGHT='\033[0;37m'
# ==========================================

# Function to display progress spinner
spinner() {
    local pid=$1
    local delay=0.1
    local spinstr='|/-\'
    while ps -p $pid > /dev/null; do
        local temp=${spinstr#?}
        printf " [%c]  " "$spinstr"
        local spinstr=$temp${spinstr%"$temp"}
        sleep $delay
        printf "\b\b\b\b\b\b"
    done
    printf "    \b\b\b\b"
}

# Must be run as root
if [[ $EUID -ne 0 ]]; then
   echo -e "${RED}Skrip ini harus dijalankan sebagai root!${NC}"
   exit 1
fi

# Cek dependensi (menambahkan wget dan rsync)
for cmd in rclone unzip file wget rsync; do
    if ! command -v $cmd &> /dev/null; then
        echo -e "${ORANGE}$cmd tidak ditemukan. Menginstall...${NC}"
        apt-get update > /dev/null 2>&1
        apt-get install -y $cmd > /dev/null 2>&1
    fi
done

clear
echo "=================================================="
echo -e "     ${CYAN}MENU RESTORE DATA PENGGUNA${NC}"
echo "=================================================="
echo ""
echo -e "Pilih sumber file backup:"
echo -e "1. Restore dari File Lokal (.zip)"
echo -e "2. Restore dari Link Google Drive"
echo ""
read -p "Masukkan pilihan [1-2]: " -r choice

BACKUP_FILE_PATH=""
DOWNLOADED_FROM_GDRIVE=false

case $choice in
    1)
        read -p "Masukkan path lengkap ke file backup (.zip): " LOCAL_FILE
        if [ ! -f "$LOCAL_FILE" ]; then
            echo -e "${RED}Error: File tidak ditemukan di '$LOCAL_FILE'${NC}"
            exit 1
        fi
        BACKUP_FILE_PATH=$LOCAL_FILE
        ;;
    2)
        read -p "Masukkan link Google Drive (pastikan sudah 'Anyone with the link'): " GDLINK
        FILE_ID=""
        if [[ "$GDLINK" =~ \/d\/(.+)\/ ]]; then
            FILE_ID="${BASH_REMATCH[1]}"
        elif [[ "$GDLINK" =~ id=([^&]+) ]]; then
            FILE_ID="${BASH_REMATCH[1]}"
        fi
        if [ -z "$FILE_ID" ]; then
            echo -e "${RED}Error: Link Google Drive tidak valid atau tidak dapat menemukan File ID.${NC}"
            exit 1
        fi
        DIRECT_DOWNLOAD_LINK="https://drive.google.com/uc?export=download&id=${FILE_ID}"
        TEMP_FILENAME="backup_download_$(date +%Y%m%d_%H%M%S).zip"
        DEST_PATH="/root/${TEMP_FILENAME}"
        echo -e "${BLUE}Mencoba download langsung sebagai '${TEMP_FILENAME}'...${NC}"
        wget -q --show-progress -O "$DEST_PATH" "$DIRECT_DOWNLOAD_LINK"
        if [ -s "$DEST_PATH" ]; then
            if file "$DEST_PATH" | grep -q "Zip archive data"; then
                BACKUP_FILE_PATH="$DEST_PATH"
                DOWNLOADED_FROM_GDRIVE=true
                echo -e "${GREEN}Download berhasil: ${TEMP_FILENAME}${NC}"
            else
                echo -e "${RED}Download gagal. File yang diunduh bukan arsip Zip yang valid.${NC}"
                rm -f "$DEST_PATH"
                exit 1
            fi
        else
            echo -e "${RED}Gagal mendownload file. Hasil download kosong atau tidak ada.${NC}"
            rm -f "$DEST_PATH" 2>/dev/null
            exit 1
        fi
        ;;
    *) echo -e "${RED}Pilihan tidak valid.${NC}"; exit 1;;
esac

echo ""
if [ -z "$BACKUP_FILE_PATH" ]; then echo -e "${RED}Tidak ada file backup yang dipilih. Proses berhenti.${NC}"; exit 1; fi

# --- KONFIRMASI PENTING ---
echo -e "${ORANGE}==================== PERINGATAN ====================${NC}"
echo -e "${RED}Proses ini akan menimpa semua data pengguna dan konfigurasi${NC}"
echo -e "${RED}VMess, VLess, Trojan, dan Xray yang ada saat ini.${NC}"
echo -e "${ORANGE}Pastikan Anda yakin sebelum melanjutkan!${NC}"
echo -e "${ORANGE}====================================================${NC}"
read -p "Apakah Anda yakin ingin melanjutkan proses restore? (y/N): " -r CONFIRM
echo ""

if [[ ! "$CONFIRM" =~ ^[yY]$ ]]; then
    echo -e "${BLUE}Proses restore dibatalkan oleh pengguna.${NC}"
    if [ "$DOWNLOADED_FROM_GDRIVE" = true ]; then rm -f "$BACKUP_FILE_PATH"; fi
    exit 0
fi

# --- MULAI PROSES RESTORE ---
TEMP_RESTORE_DIR="/root/restore_temp_$(date +%s)"
mkdir -p "$TEMP_RESTORE_DIR"
echo -e "${BLUE}Mengekstrak file backup...${NC}"
unzip -o "$BACKUP_FILE_PATH" -d "$TEMP_RESTORE_DIR" > /dev/null 2>&1
if [ $? -ne 0 ]; then
    echo -e "${RED}Gagal mengekstrak file backup. Pastikan file tidak korup.${NC}"
    rm -rf "$TEMP_RESTORE_DIR"; if [ "$DOWNLOADED_FROM_GDRIVE" = true ]; then rm -f "$BACKUP_FILE_PATH"; fi
    exit 1
fi
echo -e "${GREEN}Ekstrak berhasil.${NC}"

# --- PERBAIKAN UTAMA: MEMINDAHKAN FILE SECARA MANUAL ---
echo -e "${BLUE}Memulihkan data ke sistem (memindahkan file satu per satu)...${NC}"
cd "$TEMP_RESTORE_DIR" || exit

# Memulihkan file-file sistem
echo -e "${CYAN}Memulihkan file sistem...${NC}"
if [ -f "passwd" ]; then mv -f passwd /etc/passwd; echo " -> /etc/passwd dipulihkan"; fi
if [ -f "group" ]; then mv -f group /etc/group; echo " -> /etc/group dipulihkan"; fi
if [ -f "shadow" ]; then mv -f shadow /etc/shadow; echo " -> /etc/shadow dipulihkan"; fi
if [ -f "gshadow" ]; then mv -f gshadow /etc/gshadow; echo " -> /etc/gshadow dipulihkan"; fi
if [ -f "crontab" ]; then mv -f crontab /etc/crontab; echo " -> /etc/crontab dipulihkan"; fi

# Memulihkan folder-folder (menggunakan rsync untuk menimpa dengan benar)
echo -e "${CYAN}Memulihkan data konfigurasi...${NC}"
if [ -d "vless" ]; then rsync -a --delete vless/ /etc/vless/; echo " -> /etc/vless dipulihkan"; fi
if [ -d "vmess" ]; then rsync -a --delete vmess/ /etc/vmess/; echo " -> /etc/vmess dipulihkan"; fi
if [ -d "trojan" ]; then rsync -a --delete trojan/ /etc/trojan/; echo " -> /etc/trojan dipulihkan"; fi
if [ -d "xray" ]; then rsync -a --delete xray/ /etc/xray/; echo " -> /etc/xray dipulihkan"; fi
if [ -d "kyt" ]; then rsync -a --delete kyt/ /var/lib/kyt/; echo " -> /var/lib/kyt dipulihkan"; fi
if [ -d "html" ]; then rsync -a --delete html/ /var/www/html/; echo " -> /var/www/html dipulihkan"; fi

echo -e "${GREEN}Data berhasil dipulihkan.${NC}"
# --- AKHIR DARI PERBAIKAN ---

echo -e "${BLUE}Me-restart layanan terkait...${NC}"
(systemctl restart xray > /dev/null 2>&1 && systemctl restart nginx > /dev/null 2>&1) &
pid=$!; spinner $pid; wait $pid; echo -e "${GREEN}Layanan telah di-restart.${NC}"

echo -e "${BLUE}Membersihkan file sementara...${NC}"
rm -rf "$TEMP_RESTORE_DIR"
if [ "$DOWNLOADED_FROM_GDRIVE" = true ]; then
    if [ -f "$BACKUP_FILE_PATH" ]; then rm -f "$BACKUP_FILE_PATH"; fi
fi

echo ""
echo -e "${GREEN}==================================================${NC}"
echo -e "      ${GREEN}✅ PROSES RESTORE SELESAI ✅${NC}"
echo -e "${GREEN}==================================================${NC}"
echo ""
