#!/bin/bash
# ==========================================
# 💎 GENOM RESTORE SCRIPT V4.5 (GDRIVE FIX)
# ==========================================

# --- CONFIGURATION & COLORS ---
NC='\033[0m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
B_CYAN='\033[1;36m'
B_WHITE='\033[1;37m'

# --- PREMIUM ASSETS (PROGRESS BAR) ---
fun_bar() {
    CMD="$1"
    TEXT="$2"
    eval "$CMD" >/dev/null 2>&1 &
    PID=$!
    tput civis
    echo -ne "  ${CYAN}${TEXT} ${NC}"
    while kill -0 $PID 2>/dev/null; do
        for i in {1..4}; do echo -ne "\033[0;32m▓"; sleep 0.1; done
    done
    wait $PID
    if [ $? -eq 0 ]; then
        echo -e "  ${CYAN}⚡ ${TEXT} : ${GREEN}SUKSES ✅${NC}"
    else
        echo -e "  ${CYAN}⚡ ${TEXT} : ${RED}GAGAL ❌${NC}"
    fi
    tput cnorm
}

# --- HEADER ---
clear
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${YELLOW}           ♻️  GENOM SYSTEM RESTORE PRO  ♻️       ${NC}"
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${B_WHITE}  Fungsi : Memulihkan Data VPS dari Backup (.zip)${NC}"
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# --- 1. PILIH METODE ---
echo -e "${B_WHITE}[1/5] Pilih Sumber File Backup:${NC}"
echo -e "    [1] Dari Link (Google Drive / URL)"
echo -e "    [2] Dari File Lokal (/root/backup.zip)"
echo ""
read -p "   Input Pilihan [1-2]: " method

TEMP_DIR="/root/restore_temp"
RESTORE_FILE="/root/restore_data.zip"

# Bersihkan sisa lama
rm -rf "$TEMP_DIR" "$RESTORE_FILE"
mkdir -p "$TEMP_DIR"

if [[ "$method" == "1" ]]; then
    echo ""
    read -p "   Masukkan Link URL: " link_url
    echo ""
    
    # --- AUTO CONVERT GOOGLE DRIVE LINK ---
    # Jika link mengandung 'drive.google.com'
    if [[ "$link_url" == *"drive.google.com"* ]]; then
        # Ekstrak FILE ID
        if [[ "$link_url" =~ \/d\/([a-zA-Z0-9_-]+) ]]; then
            FILE_ID="${BASH_REMATCH[1]}"
        elif [[ "$link_url" =~ id=([a-zA-Z0-9_-]+) ]]; then
            FILE_ID="${BASH_REMATCH[1]}"
        fi
        
        if [[ -n "$FILE_ID" ]]; then
            echo -e "  ${YELLOW}ℹ️  Google Drive Link Terdeteksi. Mengonversi...${NC}"
            link_url="https://drive.google.com/u/0/uc?id=${FILE_ID}&export=download"
        fi
    fi
    # --------------------------------------

    cmd_download() {
        wget -q --no-check-certificate -O "$RESTORE_FILE" "$link_url"
    }
    fun_bar "cmd_download" "Downloading File     "
    
elif [[ "$method" == "2" ]]; then
    echo ""
    read -e -p "   Masukkan Path File Lokal: " local_path
    echo ""
    if [ -f "$local_path" ]; then
        cp "$local_path" "$RESTORE_FILE"
        echo -e "  ${GREEN}File ditemukan!${NC}"
    else
        echo -e "  ${RED}File tidak ditemukan!${NC}"
        exit 1
    fi
else
    echo -e "  ${RED}Pilihan tidak valid.${NC}"
    exit 1
fi

# Cek Validitas ZIP
if ! unzip -t "$RESTORE_FILE" > /dev/null 2>&1; then
    echo -e "\n  ${RED}ERROR: File bukan ZIP valid atau Corrupt.${NC}"
    echo -e "  ${YELLOW}Tips: Pastikan Link GDrive Anda bersifat 'Public' (Siapa saja yang memiliki link).${NC}"
    rm -f "$RESTORE_FILE"
    exit 1
fi

# --- 2. EKSTRAKSI FILE ---
echo -e "\n${B_WHITE}[2/5] Mengekstrak Data...${NC}"
cmd_unzip() {
    unzip -o "$RESTORE_FILE" -d "$TEMP_DIR"
}
fun_bar "cmd_unzip" "Extracting Backup    "

# --- 3. RESTORE SYSTEM FILES ---
echo -e "\n${B_WHITE}[3/5] Memulihkan Konfigurasi Sistem...${NC}"

cmd_restore_sys() {
    cd "$TEMP_DIR" || return 1
    
    # Restore User & Password System
    [ -f passwd ] && cp -rf passwd /etc/passwd
    [ -f group ] && cp -rf group /etc/group
    [ -f shadow ] && cp -rf shadow /etc/shadow
    [ -f gshadow ] && cp -rf gshadow /etc/gshadow
    [ -f crontab ] && cp -rf crontab /etc/crontab
    
    return 0
}
fun_bar "cmd_restore_sys" "Restoring Users/Pass "

# --- 4. RESTORE VPN & PANEL DATA ---
echo -e "${B_WHITE}[4/5] Memulihkan Data VPN & Panel...${NC}"

cmd_restore_data() {
    cd "$TEMP_DIR" || return 1
    
    # 1. Restore Xray/V2ray/Trojan
    if [ -d "xray" ]; then cp -rf xray /etc/; fi
    if [ -d "v2ray" ]; then cp -rf v2ray /etc/; fi
    if [ -d "trojan" ]; then cp -rf trojan /etc/; fi
    
    # 2. Restore ZiVPN (PENTING)
    if [ -d "zivpn" ]; then 
        mkdir -p /etc/zivpn
        cp -rf zivpn/* /etc/zivpn/
    fi
    
    # 3. Restore KYT Panel & Scripts
    if [ -d "kyt" ]; then
        # Logic Restore Smart untuk KYT
        cp -rf kyt /var/lib/
        cp -rf kyt /usr/bin/
        chmod +x /usr/bin/kyt/*
    fi
    
    # 4. Restore Web File
    if [ -d "html" ]; then
        mkdir -p /var/www/html
        cp -rf html/* /var/www/html/
    fi
    
    return 0
}
fun_bar "cmd_restore_data" "Restoring Configs    "

# --- 5. RESTART SERVICES ---
echo -e "${B_WHITE}[5/5] Merestart Layanan...${NC}"

cmd_restart() {
    systemctl daemon-reload
    services=(nginx xray v2ray trojan ssh dropbear cron haproxy zivpn udp-custom ws-stunnel fail2ban)
    
    for svc in "${services[@]}"; do
        if systemctl list-unit-files | grep -q "$svc"; then
            systemctl restart "$svc"
        fi
    done
    return 0
}
fun_bar "cmd_restart" "Restarting Services  "

# --- CLEANUP ---
rm -rf "$TEMP_DIR"
rm -f "$RESTORE_FILE"

echo ""
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}           ✅ RESTORE BERHASIL SELESAI           ${NC}"
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${B_WHITE}  Semua akun SSH, Xray, dan ZiVPN telah pulih.${NC}"
echo -e "${B_WHITE}  Password root & user telah dikembalikan.${NC}"
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
read -n 1 -s -r -p "Tekan Enter untuk kembali ke menu..."
menu
